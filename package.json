{
  "name": "eule-mcp",
  "version": "0.8.1",
  "description": "MCP server for an office assistant - E-Mail/Calendar integration, tasks & resource planning",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": "metaneutrons",
  "repository": {
    "type": "git",
    "url": "https://github.com/metaneutrons/eule-mcp.git"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.7.1",
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1",
      "fast-uri": "^3.1.8",
      "hono": "^4.13.7",
      "qs": "^6.16.0"
    }
  },
  "bin": {
    "eule-mcp": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "config.example.yaml"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "serve": "node dist/server/index.js",
    "setup": "node dist/cli/index.js setup",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "version:check": "node scripts/check-version.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "prepare": "lefthook install"
  },
  "keywords": [
    "mcp",
    "kiro",
    "office",
    "m365",
    "outlook",
    "gtd",
    "tasks",
    "calendar",
    "email"
  ],
  "dependencies": {
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "better-sqlite3": "^13.0.3",
    "fast-xml-parser": "^5.11.2",
    "imapflow": "^1.7.7",
    "js-yaml": "^5.4.2",
    "marked": "^18.0.14",
    "nodemailer": "^10.0.15",
    "open": "^11.0.4",
    "tsdav": "^2.3.5",
    "turndown": "^7.2.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.12.0",
    "lefthook": "2.1.16",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}
